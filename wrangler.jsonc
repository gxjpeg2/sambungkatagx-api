{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sambungkatagx-api",
	"main": "src/index.js",
	"compatibility_date": "2026-07-18",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sambungkata_db",
