		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT",
			"id": "26fd798b97e6423a85447208373b8bb2"
		},
		{
			"binding": "DICTIONARY_KV",
			"id": "e7e7c6ac65ed4f118cda5a448da7c6af"
		}
	],
	"vars": {
		"OWNER_USERNAME": "gxjpeg2",
		"MULTI_DEVICE_EXEMPT_USERNAME": "lalalavienroselalala",
		"REPORTED_WORDS_ACCESS": "lalalavienroselalala",
		"PIN_RESET_ACCESS": "lalalavienroselalala,lilylovely165",
		"UNLIMITED_KOMPE_PRESET_USERNAMES": "awriel"
	}
}
